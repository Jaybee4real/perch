    ;;
    *)
      echo "perch: no help topic '$topic'. Try: perch help" >&2
      return 1 ;;
  esac
}

main() {
  # global --wait / -w flag: block until launched servers pass a health check.
  WAIT_HEALTHY=0
  local a; local -a _args=()
  for a in "$@"; do
    case "$a" in --wait|-w) WAIT_HEALTHY=1 ;; *) _args+=("$a") ;; esac
  done
  set -- "${_args[@]}"

  local first="${1:-help}"
  # nested help at any level: `perch help [path...]`  or  `perch [path...] help|-h|--help`
  case "$first" in help|-h|--help) shift; help_for "$@"; return ;; esac
  if [ "$#" -ge 2 ]; then
    case "${@: -1}" in
      help|-h|--help) set -- "${@:1:$(($#-1))}"; help_for "$@"; return ;;
    esac
  fi
  case "$first" in
    help|-h|--help) usage ;;
    -v|--version) echo "perch $PERCH_VERSION" ;;
    fav|favorites|favourites) shift; cmd_fav "$@" ;;
    pick|choose) cmd_pick ;;
    bounds|pos|position) shift; cmd_bounds "$@" ;;
    killall|kill-all|stopall) shift; cmd_killall "$@" ;;
    clear|cls) cmd_clear ;;
    open) shift; cmd_open "${1:-}" ;;
    url|urls) shift; cmd_url "${1:-}" ;;
    completion|completions) shift; cmd_completion "$@" ;;
    _names) project_names ;;
    place|arrange) shift; cmd_place "$@" ;;
    set|settings) shift; cmd_set "$@" ;;
    gui|dashboard|ui) shift; cmd_gui "$@" ;;
    setup) cmd_setup ;;
    doctor|check) cmd_doctor ;;
    list|ls) shift; cmd_list "$@" ;;
    groups|clusters|cluster|by-product) cmd_groups ;;
    autoplace|auto) shift; cmd_autoplace "$@" ;;
    park) shift; cmd_park "$@" ;;
    reap|orphans) shift; cmd_reap "$@" ;;
    apps|app|pin) shift; cmd_apps "$@" ;;
    unpark) cmd_unpark ;;
    bar|menubar|toolbar) shift; cmd_bar "$@" ;;
    agent) shift; cmd_agent "$@" ;;
    agents|herd) shift; cmd_agents "$@" ;;
    cockpit) shift; cmd_cockpit "$@" ;;
    start|restart|run)
      shift
      if [ "$#" -ge 1 ]; then
        run_project "$1" || { not_found "$1"; exit 1; }
      else
        local here; here="$(current_project)"
        if [ -n "$here" ]; then
          echo "[perch] $first '$here' (this terminal)"
          run_project "$here"
        else
          echo "perch: no project for this terminal — not a perch tab, and the current dir isn't a registered project." >&2
          echo "  give a name (perch $first <project>) or run it from the project's perch tab / directory." >&2
          exit 1
        fi
      fi ;;
    stop)
      shift
      if [ "${1:-}" = "all" ]; then shift; cmd_killall "$@"; else cmd_stop "$@"; fi ;;
    add) shift; cmd_add "$@" ;;
    remove|rm) shift; cmd_remove "$@" ;;
    config) echo "$CONFIG" ;;
    port) shift; cmd_port "$@" || { echo "perch: no port for $([ -n "${1:-}" ] && echo "'$1'" || echo 'this directory')" >&2; exit 1; } ;;
    *)
      if [ $# -eq 1 ]; then
        run_project "$first" || { not_found "$first"; exit 1; }
      elif [ $# -ge 4 ]; then
        local marker="$1" dir="$2" port="$3"
        shift 3
        launch "$marker" "$dir" "$port" "$*"
      else
        not_found "$first"
        exit 1
      fi
      ;;
  esac
}

# Run only when executed directly; `source`-ing (e.g. from test-perch.sh) just
# loads the functions for testing.
if [ "${BASH_SOURCE[0]:-$0}" = "${0}" ]; then
  main "$@"
fi
